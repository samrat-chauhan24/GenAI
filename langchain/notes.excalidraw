    {
      "id": "qKX_h-sIJCPkE7TZKCsof",
      "type": "text",
      "x": -5331.095597597402,
      "y": 3643.98845493238,
      "width": 974.9036254882812,
      "height": 770,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
