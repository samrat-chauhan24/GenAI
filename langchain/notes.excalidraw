    {
      "id": "5fSm7zGtoTA-KzQa5_pb9",
      "type": "text",
      "x": -4252.588440667284,
      "y": 3688.17905344039,
      "width": 968.043701171875,
      "height": 560,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8p",
      "roundness": null,
      "seed": 2087501796,
      "version": 2756,
      "versionNonce": 775894661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "-> Prompts are basically the inputs provided to the models, they plays\nand important role in the output. \n\n-> This component has so much importance that we have a whole,\nstudy about it known as Prompt Engineering, and this job profile\nis known as Prompt Engineer.\n\n-> there are many types of prompts in LangChain:\n 1. dynamic and reusable prompts\n\n 2. role based prompts\n\n 3. few shot prompting - before anything some examples are given to\n the model, and then the actual prompt is given and the model answers\n on the basis of the examples provided.\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Prompts are basically the inputs provided to the models, they plays\nand important role in the output. \n\n-> This component has so much importance that we have a whole,\nstudy about it known as Prompt Engineering, and this job profile\nis known as Prompt Engineer.\n\n-> there are many types of prompts in LangChain:\n 1. dynamic and reusable prompts\n\n 2. role based prompts\n\n 3. few shot prompting - before anything some examples are given to\n the model, and then the actual prompt is given and the model answers\n on the basis of the examples provided.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
