    },
    {
      "id": "6Z87j_8w-tSVCZ5KVc2bk",
      "type": "text",
      "x": -4230.279286148053,
      "y": 4386.628999772788,
      "width": 929.9356689453125,
      "height": 455,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8w",
      "roundness": null,
      "seed": 1576647004,
      "version": 3057,
      "versionNonce": 117727275,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "-> Chains are used to build the pipelines in LangChain.\n\n-> these are like nodes connected to each other, where the output\nof one node is treated as the input for the next node, this is done\nautomatically. the developer just needs to connect both nodes.\n\n-> without chains, we need to build these pipelines or connection\nmanually which is both costly and complex, because you have to\ntake the output from one block and then put it as the input for\nthe next block.\n\n-> Chains can also be helpful to build complex pipelines, like \nparallel chains, conditional chains.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Chains are used to build the pipelines in LangChain.\n\n-> these are like nodes connected to each other, where the output\nof one node is treated as the input for the next node, this is done\nautomatically. the developer just needs to connect both nodes.\n\n-> without chains, we need to build these pipelines or connection\nmanually which is both costly and complex, because you have to\ntake the output from one block and then put it as the input for\nthe next block.\n\n-> Chains can also be helpful to build complex pipelines, like \nparallel chains, conditional chains.",
      "autoResize": true,
      "lineHeight": 1.25
    },
