      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "-> there are 2 types of models with which LC can communicate:\n 1. LLMs - these are the models which take text input and gives\n text output.\n\n 2. Embedding Model - these also takes input in text, but they \n give output in vectors. They are mainly used for the semantic\n search.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> there are 2 types of models with which LC can communicate:\n 1. LLMs - these are the models which take text input and gives\n text output.\n\n 2. Embedding Model - these also takes input in text, but they \n give output in vectors. They are mainly used for the semantic\n search.",
      "autoResize": true,
      "lineHeight": 1.25
    },
