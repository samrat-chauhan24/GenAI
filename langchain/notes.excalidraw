    {
      "id": "eiaFwuZVgvy4i5Rid8m44",
      "type": "text",
      "x": -3147.071907594772,
      "y": 4263.3423486862175,
      "width": 949.6757202148438,
      "height": 525,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b97",
      "roundness": null,
      "seed": 1896190556,
      "version": 2922,
      "versionNonce": 1925720293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "-> LLM API calls are stateless, means every call is independent and it\ndoesn't have any context of the previous call.\n\n-> This is a very big problem, referring or telling same thing to the \nmodel again and again is not optimal, therefore langchain addressed\nit and introduced memory component.\n\n-> some types of memory are: \n ConversationBufferMemory - stores transcript of recent messages.\n \n ConversationBufferWindowMemory - keeps last N interactions\n \n Summariser-Based Memory - periodically summarises older chats\n \n Custom Memory - storing specialised states(like user's preferences).",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> LLM API calls are stateless, means every call is independent and it\ndoesn't have any context of the previous call.\n\n-> This is a very big problem, referring or telling same thing to the \nmodel again and again is not optimal, therefore langchain addressed\nit and introduced memory component.\n\n-> some types of memory are: \n ConversationBufferMemory - stores transcript of recent messages.\n \n ConversationBufferWindowMemory - keeps last N interactions\n \n Summariser-Based Memory - periodically summarises older chats\n \n Custom Memory - storing specialised states(like user's preferences).",
      "autoResize": true,
      "lineHeight": 1.25
    },
