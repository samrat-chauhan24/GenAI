    {
      "id": "as-50-z0tYSxsES8iWSgS",
      "type": "text",
      "x": 2159.1025731385103,
      "y": -2146.073109182532,
      "width": 1134.5755615234375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7u",
