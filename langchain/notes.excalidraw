    {
      "id": "blGXaR2f-EeMGWWQiXfFa",
      "type": "text",
      "x": -2058.617929493711,
      "y": 3872.254161078092,
      "width": 940.043701171875,
      "height": 840,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9C",
      "roundness": null,
      "seed": 45684452,
      "version": 2959,
      "versionNonce": 215041323,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "-> as we know that LLMs are capable for NLU and Context Aware\nText Generation which can be use to make a ChatBot.\n\n-> and if they are capable to have a conversation then they can\nalso execute some steps and complete a task for the user.\n\n-> for eg:\nuser1 - what is an ideal place to go on a trip in summers\nAi - hill station are ideal places in summers to enjoy\nuser2 - can you tell me a city in India where should i go.\nAi - shimla, manali can be a great options.\nuser3 - what is the cost of cheapest flight to manali on 26march.\nAi - Indigo from delhi to manali on 26 march at 7pm.\nuser4 - can you book my ticket for the same.\nAi - Yes Why not wait a minute.\nAi - Your booking is done kindly check your mail and refer attached\ndoc for the seat numbers and boarding pass.\n\n-> basically agents are superior form of the chatbots that not only \ntalks but can perform actual tasks for the user.\n\n-> ai agents have reasoning capabilities and access to different\nnumber of tools which it uses to perform the task.\n ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> as we know that LLMs are capable for NLU and Context Aware\nText Generation which can be use to make a ChatBot.\n\n-> and if they are capable to have a conversation then they can\nalso execute some steps and complete a task for the user.\n\n-> for eg:\nuser1 - what is an ideal place to go on a trip in summers\nAi - hill station are ideal places in summers to enjoy\nuser2 - can you tell me a city in India where should i go.\nAi - shimla, manali can be a great options.\nuser3 - what is the cost of cheapest flight to manali on 26march.\nAi - Indigo from delhi to manali on 26 march at 7pm.\nuser4 - can you book my ticket for the same.\nAi - Yes Why not wait a minute.\nAi - Your booking is done kindly check your mail and refer attached\ndoc for the seat numbers and boarding pass.\n\n-> basically agents are superior form of the chatbots that not only \ntalks but can perform actual tasks for the user.\n\n-> ai agents have reasoning capabilities and access to different\nnumber of tools which it uses to perform the task.\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
