      "seed": 505247139,
      "version": 707,
      "versionNonce": 641649707,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "1. install the llm library you want to use, in my case  i used Groq.\n2. get an api key from their website after creating the account.\n3. pip install groq\n4. Code\n \n  \n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. install the llm library you want to use, in my case  i used Groq.\n2. get an api key from their website after creating the account.\n3. pip install groq\n4. Code\n \n  \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9xJ8xbLzHrqPfkeOhe3Qe",
      "type": "text",
      "x": 2163.6904523223466,
      "y": -1957.7799582974935,
      "width": 1563.071044921875,
      "height": 1610,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7v",
      "roundness": null,
      "seed": 1858354381,
      "version": 1348,
      "versionNonce": 2063835141,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "import os \nfrom groq import Groq\n# this is the api key it is exported in the terminal\nclient = Groq(api_key=os.environ.get(\"GROQ_API_KEY\"))\n\nthis message goes in with the user message, again and again so the chatbot doesn't loose the behavior context  \nmessages=[\n        {\n            \"role\":\"system\",\n            \"content\":\"you are a DSA master with 20 years of exp keep answers short and plain, \n             if user asks anything other than DSA you must say not relevant to DSA\"            \n        }        \n    ]    \n\nprint(\"The Chatbot is ready, type 'exit' to quit.\\n\")\n# for the chat looping, so the program doesn't end after giving one answer\nwhile True:\n    userInput = input(\"typeHere: \")\n    if userInput.lower() == \"exit\":\n        print(\"chat ended\")\n        break\n    # this is added in the messages list\n    messages.append(\n        {\n            \"role\":\"user\",\n            \"content\": userInput\n        }\n    )\n    # the response is stored here\n    response = client.chat.completions.create(\n    model=\"llama-3.1-8b-instant\",\n    messages=messages,# as the messages is defined  globally\n    temperature=0.7\n    )\n    # this chooses the choice if if there are, multiple choices\n   assistant = response.choices[0].message.content \n    print(\"Ai: \", assitant)\n    print(\"tokensUsed\", response.usage.total_tokens)\n    print(\"totalTime\", response.usage.total_time)\n    print()\n    messages.append(\n        {\n            \"role\": \"assistant\",\n            \"content\": ChatGpt\n        }\n    )",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import os \nfrom groq import Groq\n# this is the api key it is exported in the terminal\nclient = Groq(api_key=os.environ.get(\"GROQ_API_KEY\"))\n\nthis message goes in with the user message, again and again so the chatbot doesn't loose the behavior context  \nmessages=[\n        {\n            \"role\":\"system\",\n            \"content\":\"you are a DSA master with 20 years of exp keep answers short and plain, \n             if user asks anything other than DSA you must say not relevant to DSA\"            \n        }        \n    ]    \n\nprint(\"The Chatbot is ready, type 'exit' to quit.\\n\")\n# for the chat looping, so the program doesn't end after giving one answer\nwhile True:\n    userInput = input(\"typeHere: \")\n    if userInput.lower() == \"exit\":\n        print(\"chat ended\")\n        break\n    # this is added in the messages list\n    messages.append(\n        {\n            \"role\":\"user\",\n            \"content\": userInput\n        }\n    )\n    # the response is stored here\n    response = client.chat.completions.create(\n    model=\"llama-3.1-8b-instant\",\n    messages=messages,# as the messages is defined  globally\n    temperature=0.7\n    )\n    # this chooses the choice if if there are, multiple choices\n   assistant = response.choices[0].message.content \n    print(\"Ai: \", assitant)\n    print(\"tokensUsed\", response.usage.total_tokens)\n    print(\"totalTime\", response.usage.total_time)\n    print()\n    messages.append(\n        {\n            \"role\": \"assistant\",\n            \"content\": ChatGpt\n        }\n    )",
      "autoResize": true,
      "lineHeight": 1.25
    },
