      "text": "Indexes",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t7rb9wzv4ezTemCx45mKa",
      "originalText": "Indexes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FDhqArtcY5-h_G0KLAlxv",
      "type": "text",
      "x": -3158.275767631897,
      "y": 3797.384681095291,
      "width": 980.1956787109375,
      "height": 385,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b92",
      "roundness": null,
      "seed": 1506683236,
      "version": 2617,
      "versionNonce": 1961176075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773163173303,
      "link": null,
      "locked": false,
      "text": "-> Indexes connect your application to external knowledge - such as\nPDFs, websites or databases.\n\n-> they consists of - doc loader, text splitter, vector store, retrievers.\n\n-> for eg - if i ask what is the method of giving internal marks in my\ncollege miet as the model has never seen this type of data before,\nit cant answer this, in such cases indexes comes into role and then\nmodel can retrieve data from external data sources (websites/ pdfs).\n\n ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Indexes connect your application to external knowledge - such as\nPDFs, websites or databases.\n\n-> they consists of - doc loader, text splitter, vector store, retrievers.\n\n-> for eg - if i ask what is the method of giving internal marks in my\ncollege miet as the model has never seen this type of data before,\nit cant answer this, in such cases indexes comes into role and then\nmodel can retrieve data from external data sources (websites/ pdfs).\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
